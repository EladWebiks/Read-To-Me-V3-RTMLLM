# Application
APP_ENV=local
DEBUG=false

# Postgres
DB_PORT=5432
DB_NAME=rtm
DB_USER=rtm
DB_PASSWORD=rtm
# App database (docker compose / local UI)
DATABASE_URL=postgresql+asyncpg://rtm:rtm@localhost:5432/rtm
# Pytest uses this (or TEST_DATABASE_URL) so integration tests never wipe app data
# TEST_DATABASE_URL=postgresql+asyncpg://rtm:rtm@localhost:5432/rtm_test

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# MinIO
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=rtm
MINIO_SECRET_KEY=rtmsecret
MINIO_BUCKET=rtm
MINIO_ENDPOINT=localhost:9000
MINIO_SECURE=false
MINIO_PUBLIC_ENDPOINT=localhost:9000

# API / frontend (local host development)
BACKEND_PORT=8000
FRONTEND_PORT=3000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
# Leave empty when using Vite proxy; set for absolute API URL if needed
VITE_API_URL=

# Auth (single local admin; password is hashed at rest)
JWT_SECRET=dev-only-change-me-to-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Downloads / listen MP3 retention (MinIO objects + job rows)
DOWNLOAD_JOB_TTL_HOURS=24
SIGNED_URL_EXPIRES_SECONDS=3600

# LLM (Milestone B foundation). Keep LLM_ENABLED=false unless you have a key.
LLM_ENABLED=false
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=2048
LLM_MAX_RETRIES=2
LLM_MAX_TURN_TOKENS_IN=64000
LLM_CONTEXT_RECENT_MESSAGES=10
LLM_SUMMARY_TRIGGER_TOKENS=12000
LLM_SUMMARY_MAX_OUTPUT_TOKENS=1200
LANGFUSE_ENABLED=false
# internal_only hides scrape/external tools; use external_allowed for HITL scrape in chat
LLM_ASSISTANT_MODE=internal_only
LLM_HITL_TTL_SECONDS=900
LLM_MAX_HITL_ROUNDS=3
