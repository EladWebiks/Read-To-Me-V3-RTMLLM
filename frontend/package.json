    "@radix-ui/react-switch": "^1.3.5",
    "@radix-ui/react-tooltip": "^1.2.14",
    "@tailwindcss/vite": "^4.1.11",
    "@tanstack/react-query": "^5.83.0",
    "class-variance-authority": "^0.7.1",
